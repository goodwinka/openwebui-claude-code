# ═══════════════════════════════════════════════════════════════════
# Open WebUI ↔ Claude Code Bridge — конфигурация окружения
# Скопируйте в .env и заполните значения:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════

# ─── Anthropic ───────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО: ваш Anthropic API ключ
ANTHROPIC_API_KEY=sk-ant-...

# Модель Claude: opus, sonnet, haiku (или полный ID модели)
CLAUDE_MODEL=sonnet

# Список разрешённых инструментов Claude Code (через запятую)
ALLOWED_TOOLS=Read,Edit,Write,Bash,Glob,Grep

# Режим разрешений: acceptEdits, default, bypassPermissions
PERMISSION_MODE=acceptEdits

# Максимальное число ходов диалога
MAX_TURNS=50

# ─── Auth ────────────────────────────────────────────────────────

# ОБЯЗАТЕЛЬНО: секретный ключ API для Open WebUI (любая строка)
API_SECRET_KEY=change-me-please

# ─── Workspaces ──────────────────────────────────────────────────

# Корневая директория рабочих пространств
WORKSPACES_ROOT=/srv/workspaces

# Максимальное число воркспейсов на пользователя
MAX_WORKSPACES_PER_USER=10

# ─── Сервис ──────────────────────────────────────────────────────

# Системный пользователь, от имени которого запускается Claude Code
SERVICE_USER=claude-code

# Параметры HTTP-сервера
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ─── Git интеграция ──────────────────────────────────────────────

# GitLab personal/project access token (опционально)
GITLAB_TOKEN=

# GitHub token (опционально, fallback если gh CLI недоступен)
GITHUB_TOKEN=

# Прокси (опционально)
HTTP_PROXY=
HTTPS_PROXY=

# Информация об авторе коммитов
GIT_USER_NAME=Claude Code
GIT_USER_EMAIL=claude-code@localhost

# Глубина git clone (0 = полный clone)
GIT_CLONE_DEPTH=1

# Префикс для создаваемых веток
GIT_BRANCH_PREFIX=claude/session-

# Таймаут запросов к GitHub/GitLab API (секунды)
GIT_API_TIMEOUT=30

# Проверять SSL-сертификат GitLab (false — для self-hosted без валидного сертификата)
GITLAB_SSL_VERIFY=False

# Удалять ветку-источник после merge MR в GitLab
GITLAB_MR_REMOVE_SOURCE_BRANCH=False
